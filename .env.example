# Copy to .env and change the secrets. Shared by the db and backend services.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=pass
POSTGRES_USER=pass
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Host port for the backend container (compose only)
BACKEND_PORT=8000

# Object storage (REC-1). MinIO in compose; for a cloud bucket change the endpoints, bucket and keys.
# STORAGE_ENDPOINT: how the backend and minio-init reach storage inside compose.
# STORAGE_PUBLIC_ENDPOINT: how phones reach it; host and port must match the published MinIO port below.
# Leave STORAGE_ENDPOINT empty to use an in-memory fake (no uploads are really stored).
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=pass
STORAGE_ACCESS_KEY=pass-minio
STORAGE_SECRET_KEY=change-me-minio-secret
STORAGE_REGION=us-east-1

# Host ports for MinIO (compose only); change them if 9000 or 9001 is taken, and update STORAGE_PUBLIC_ENDPOINT to match
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
