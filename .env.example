# Copy to .env and change the secrets. Shared by the db and backend services.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=pass
POSTGRES_USER=pass
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Firebase service-account JSON file for push notifications (NOTE-11). Optional: leave empty and pushes are only logged.
# In compose, mount the file into the backend and scheduler containers and put its in-container path here.
FCM_CREDENTIALS_FILE=

# Host port for the backend container (compose only)
BACKEND_PORT=8000

# Object storage (REC-1). SeaweedFS (S3 API) in compose; for a cloud bucket change the endpoints, bucket and keys.
# STORAGE_ENDPOINT: how the backend reaches storage inside compose.
# STORAGE_PUBLIC_ENDPOINT: how phones reach it; host and port must match STORAGE_PORT below.
# Leave STORAGE_ENDPOINT empty to use an in-memory fake (no uploads are really stored).
STORAGE_ENDPOINT=http://storage:8333
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=pass
STORAGE_ACCESS_KEY=pass-storage
STORAGE_SECRET_KEY=change-me-storage-secret
STORAGE_REGION=us-east-1

# Host port for storage (compose only); change it if 9000 is taken, and update STORAGE_PUBLIC_ENDPOINT to match
STORAGE_PORT=9000
