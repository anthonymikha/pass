# Copy to .env and change the secrets. Shared by the db and backend services.
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-50-characters
DEBUG=0
# 1 on a server behind Traefik or Caddy (secure cookies, HSTS, redirect to https). 0 only for a local stack on plain http.
HTTPS=1
# Optional: defaults to PASS_HOST without its port.
# ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=pass
POSTGRES_USER=pass
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Public host names (docs/deployment.md): DNS A records at the registrar point both at the server.
# PASS_HOST serves /api/, /admin/, /static/ and /account/ (password reset links, ACC-32); FILES_HOST serves storage.
PASS_HOST=pass.example.com
FILES_HOST=files.example.com

# On a server, let plain `docker compose` (and scripts/autoupdate.sh) use the proxy override:
# COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml

# Behind an existing Traefik (docker-compose.traefik.yml): its external network, entrypoint and certificate resolver.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Email (ACC-32). SMTP server, e.g. Brevo (smtp-relay.brevo.com, port 587, STARTTLS). Leave EMAIL_HOST empty and
# emails are only written to the log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=PASS <no-reply@example.com>

# Firebase service-account JSON file for push notifications (NOTE-11). Optional: leave empty and pushes are only logged.
# In compose, mount the file into the backend and scheduler containers and put its in-container path here.
FCM_CREDENTIALS_FILE=

# Host port for the backend container (compose only)
BACKEND_PORT=8000

# Object storage (REC-1). SeaweedFS (S3 API) in compose; for a cloud bucket change the endpoints, bucket and keys.
# STORAGE_ENDPOINT: how the backend reaches storage inside compose.
# STORAGE_PUBLIC_ENDPOINT: how phones reach it; locally host and port must match STORAGE_PORT below; on a server
# https://FILES_HOST (the proxy forwards it to storage).
# Leave STORAGE_ENDPOINT empty to use an in-memory fake (no uploads are really stored).
STORAGE_ENDPOINT=http://storage:8333
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=pass
STORAGE_ACCESS_KEY=pass-storage
STORAGE_SECRET_KEY=change-me-storage-secret
STORAGE_REGION=us-east-1

# Host port for storage (compose only); change it if 9000 is taken, and update STORAGE_PUBLIC_ENDPOINT to match
STORAGE_PORT=9000
