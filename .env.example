# Copy to .env and change the secrets. Shared by the db and backend services.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=pass
POSTGRES_USER=pass
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Host port for the backend container (compose only)
BACKEND_PORT=8000
